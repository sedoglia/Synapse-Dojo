{
  "name": "synapse-dojo",
  "private": true,
  "version": "0.12.24",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && npm run check:api && vite build --mode web",
    "build:web": "tsc && npm run check:api && vite build --mode web",
    "check:anagrams": "node scripts/check-anagrams.mjs",
    "check:i18n": "node scripts/verify-i18n.mjs",
    "check:api": "wrangler types server/worker-configuration.d.ts && tsc -p tsconfig.api.json",
    "dev:api": "wrangler d1 migrations apply synapse-board --local && wrangler pages dev dist --port 8788",
    "preview": "vite preview",
    "deploy": "node scripts/deploy-web.mjs",
    "deploy:web": "node scripts/deploy-web.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wrangler": "4.156.2"
  }
}
