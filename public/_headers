# Cloudflare Pages response headers (ignored by other hosts).
# The CSP allows only this site plus the Cloudflare Web Analytics beacon; speech synthesis, audio and the
# service worker need no network permissions. Blob URLs are used for the calendar and progress downloads.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; media-src 'self' data: blob:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# Vite puts a content hash in every file name under assets/, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=2592000

# Entry points and the service worker are always revalidated, so updates show up at once.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/privacy
  Cache-Control: no-cache
/privacy.html
  Cache-Control: no-cache
/guide
  Cache-Control: no-cache
/guide.html
  Cache-Control: no-cache
/license
  Cache-Control: no-cache
/license.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache
