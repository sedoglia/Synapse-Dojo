node_modules/
dist/
# Never commit disc images or extracted third-party assets
*.iso
*.nds

# Local settings, e.g. .env.web.local with the analytics token
*.local
.wrangler/
# Android app (docs/android.md): only android/twa-manifest.json is kept. The Android project that Bubblewrap
# generates next to it can be rebuilt at any time, and the signing key must never be committed, wherever it is.
android/*
!android/twa-manifest.json
*.keystore
*.jks
*.p12
*.pepk
*.apk
*.aab
*.idsig
# Generated by `npm run check:api`
server/worker-configuration.d.ts
